{
  "name": "@junction/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Approval app (phone-first): approval queue, buyer and Aimo audit views, request form.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "dev:live": "VITE_GATEWAY_URL=/ vite --host 0.0.0.0",
    "dev:https": "HTTPS=1 VITE_GATEWAY_URL=/ vite --host 0.0.0.0"
  },
  "dependencies": {
    "@junction/shared": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.17"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8"
  }
}
