{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "packages/ui/",
      "framework": "vite"
    },
    "gateway": {
      "root": "deploy/gateway/",
      "framework": "fastify",
      "buildCommand": "npm run vercel-build",
      "entrypoint": "index.cjs"
    },
    "assistant": {
      "root": "deploy/assistant/",
      "buildCommand": "npm run vercel-build",
      "entrypoint": "index.cjs",
      "bindings": [
        { "type": "service", "service": "gateway", "format": "url", "env": "GATEWAY_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "assistant" } },
    { "source": "/v1/(.*)", "destination": { "service": "gateway" } },
    { "source": "/.well-known/(.*)", "destination": { "service": "gateway" } },
    { "source": "/docs", "destination": { "service": "gateway" } },
    { "source": "/docs/(.*)", "destination": { "service": "gateway" } },
    { "source": "/mcp", "destination": { "service": "gateway" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
