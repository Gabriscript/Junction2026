{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "packages/ui/",
      "framework": "vite"
    },
    "gateway": {
      "root": "packages/gateway/",
      "framework": "fastify",
      "entrypoint": "src/server.ts"
    },
    "assistant": {
      "root": "packages/agent/",
      "entrypoint": "src/assistant/server.ts",
      "bindings": [
        { "type": "service", "service": "gateway", "format": "url", "env": "GATEWAY_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "assistant" } },
    { "source": "/v1/(.*)", "destination": { "service": "gateway" } },
    { "source": "/.well-known/(.*)", "destination": { "service": "gateway" } },
    { "source": "/docs", "destination": { "service": "gateway" } },
    { "source": "/docs/(.*)", "destination": { "service": "gateway" } },
    { "source": "/mcp", "destination": { "service": "gateway" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
